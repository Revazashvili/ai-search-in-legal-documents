# Copy this file to .env and fill in values before running docker compose

# ── AI provider ──────────────────────────────────────────────────────────────
# Option A: Ollama (default, local)
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_CHAT_MODEL=llama3.1:8b

# Option B: OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the API (must be reachable from the client)
NEXT_PUBLIC_API_URL=http://localhost:5081

# ── Database (docker-compose default — override only if using external PG) ───
# POSTGRES_DB=legaldocumentaisearch
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
